      "passage": "Use create_list_item, lookup_list_item or update_list_item for local SharePoint-like records only.",
      "score": 0.0,
      "content_sha256": "bdf15b827bdbd3cf628a3f9f80b2d5cf06bd3a253ac872fc8a3e7dca00db5109",
      "trusted_as_instructions": false
    }
  ],
  "warnings": [
    "Threshold and explicit manager decision are supported locally."
  ],
  "requires_manual_review": false,
  "simulation_mode": true,
  "provider": "mock"
}
